+#define GGML_VQ3_0_UNPACK_STEP(i)     const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d) * GGML_VQ3_G;     const __m512i raw_22   = _mm512_maskz_loadu_epi8(0x00000000003FFFFFULL, x[i].qs);     const __m512i gathered = _mm512_permutexvar_epi8(shuf_sc_gather, raw_22);     const __m512i bits01   = _mm512_and_si512(_mm512_srlv_epi16(gathered, sc_rshift), mask_b01);     const __m512i s8_i32   = _mm512_dpbusd_epi32(sc_base2, bits01, weights_sc);     const __m512i vmult    = _mm512_permutexvar_epi16(shuf_mult_i16, s8_i32);     __m512i t_idx          = _mm512_permutexvar_epi8(perm_rep64, raw_22);     t_idx                  = _mm512_mask2_permutex2var_epi8(lut1_lo, t_idx, 0x00000FFFFFC00000ULL, lut1_hi);     t_idx                  = _mm512_mask2_permutex2var_epi8(lut2_lo, t_idx, 0xFFFFF00000000000ULL, lut2_hi);     const __m512i q_s8     = _mm512_mask2_permutex2var_epi8(lut0_lo, t_idx, 0x00000000003FFFFFULL, lut0_hi);     const __m512i q_abs    = _mm512_abs_epi8(q_s8);     const __mmask64 neg_mask = _mm512_movepi8_mask(q_s8);
