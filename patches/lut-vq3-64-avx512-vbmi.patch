+    const block_q8_0 * GGML_RESTRICT y1 = (const block_q8_0 *)vy[1];
+    const block_q8_0 * GGML_RESTRICT y2 = (const block_q8_0 *)vy[2];
+    const block_q8_0 * GGML_RESTRICT y3 = (const block_q8_0 *)vy[3];
