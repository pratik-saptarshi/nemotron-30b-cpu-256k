+            qw[j + 22] = ggml_vq3_cb[c][1];
+            qw[j + 44] = ggml_vq3_cb[c][2];
+        }
+        for (int j = 20; j < 22; ++j) {
+            const int c = x[i].qs[j] & 0x7F;
+            qw[j]      = ggml_vq3_cb[c][0];
+            qw[j + 22] = ggml_vq3_cb[c][1];
+        }
+        int32_t sum0 = 0, sum1 = 0;
+        for (int b = 0; b < 4; ++b) {
+            int32_t sb = 0;
+            for (int j = 0; j < 8; ++j) sb += (int32_t)qw[b * 8 + j] * (int32_t)y[2 * i + 0].qs[b * 8 + j];
+            sum0 += sb * m[b];
+        }
+        for (int b = 4; b < 8; ++b) {
+            int32_t sb = 0;
+            for (int j = 0; j < 8; ++j) sb += (int32_t)qw[b * 8 + j] * (int32_t)y[2 * i + 1].qs[(b - 4) * 8 + j];
+            sum1 += sb * m[b];
+        }
+        sumf += d0 * (GGML_CPU_FP16_TO_FP32(y[2 * i + 0].d) * (float)sum0 +
+                      GGML_CPU_FP16_TO_FP32(y[2 * i + 1].d) * (float)sum1);
+    }
+    *s = sumf;
+#endif
+}
