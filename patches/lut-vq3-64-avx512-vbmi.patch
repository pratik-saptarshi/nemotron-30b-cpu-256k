+#if defined(__AVX512F__) && defined(__AVX512BW__) && defined(__AVX512VBMI__) && defined(__AVX512VNNI__)
+#define GGML_VQ3_0_INIT_CONSTS()     const __m512i zero512        = _mm512_setzero_si512();     const __m512i lut0_lo        = _mm512_load_si512((const __m512i *)ggml_vq3_lut0_lo);     const __m512i lut0_hi        = _mm512_load_si512((const __m512i *)ggml_vq3_lut0_hi);     const __m512i lut1_lo        = _mm512_load_si512((const __m512i *)ggml_vq3_lut1_lo);     const __m512i lut1_hi        = _mm512_load_si512((const __m512i *)ggml_vq3_lut1_hi);     const __m512i lut2_lo        = _mm512_load_si512((const __m512i *)ggml_vq3_lut2_lo);     const __m512i lut2_hi        = _mm512_load_si512((const __m512i *)ggml_vq3_lut2_hi);     const __m512i perm_rep64     = _mm512_load_si512((const __m512i *)ggml_vq3_perm_rep64);     const __m512i shuf_sc_gather = _mm512_load_si512((const __m512i *)ggml_vq3_shuf_sc_gather);     const __m512i sc_rshift      = _mm512_load_si512((const __m512i *)ggml_vq3_sc_rshift);     const __m512i mask_b01       = _mm512_set1_epi8(0x01);     const __m512i weights_sc     = _mm512_load_si512((const __m512i *)ggml_vq3_weights_sc);     const __m512i sc_base2       = _mm512_set1_epi32(2);     const __m512i shuf_mult_i16  = _mm512_load_si512((const __m512i *)ggml_vq3_shuf_mult_i16);
+
+#define GGML_VQ3_0_DOT_COL(ycol, acc) \
+    { \
+        const __m256i y0_256 = _mm256_loadu_si256((const __m256i *)(ycol)[2 * i + 0].qs); \
+        const __m256i y1_256 = _mm256_loadu_si256((const __m256i *)(ycol)[2 * i + 1].qs); \
+        const __m512i y_s8   = _mm512_inserti64x4(_mm512_castsi256_si512(y0_256), y1_256, 1); \
+        const __m512i y_neg  = _mm512_sub_epi8(zero512, y_s8); \
+        const __m512i y_sign = _mm512_mask_mov_epi8(y_s8, neg_mask, y_neg); \
+        const __m512i p_i32  = _mm512_dpbusd_epi32(zero512, q_abs, y_sign); \
+        const __m512i p_lo   = _mm512_madd_epi16(_mm512_packs_epi32(p_i32, zero512), vmult); \
+        const __m256i sum_lo = _mm512_castsi512_si256(p_lo); \
+        const __m256i sum_hi = _mm512_extracti64x4_epi64(p_lo, 1); \
+        const float dy0 = d0 * GGML_CPU_FP16_TO_FP32((ycol)[2 * i + 0].d); \
+        const float dy1 = d0 * GGML_CPU_FP16_TO_FP32((ycol)[2 * i + 1].d); \
+        const __m512 vscale = _mm512_insertf32x8(_mm512_castps256_ps512(_mm256_set1_ps(dy0)), _mm256_set1_ps(dy1), 1); \
+        const __m512i sum16 = _mm512_inserti64x4(_mm512_castsi256_si512(sum_lo), sum_hi, 1); \
+        (acc) = _mm512_fmadd_ps(_mm512_cvtepi32_ps(sum16), vscale, (acc)); \
+    }
